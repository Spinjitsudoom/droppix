<?xml version="1.0" encoding="utf-8"?>
<!-- Child order is load-bearing: later children draw above earlier ones and get touch
     dispatch first. GlDisplayView consumes MotionEvents without calling super, so anything
     interactive MUST be a later sibling of it, not a descendant or an earlier child. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.droppix.app.ui.GlDisplayView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:padding="6dp"
        android:textColor="#00FF00"
        android:textSize="12sp"
        android:background="#80000000"
        android:fontFamily="monospace"
        android:text="" />

    <!-- In-stream settings overlay. Clickable so taps land here rather than on the surface.
         Hidden until the gear is tapped; the stream keeps running underneath throughout. -->
    <ScrollView
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#D0000000"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/panel_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="Done"
                    android:textColor="#FFFFFF"
                    android:background="#40FFFFFF" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Applies instantly" android:textColor="#8AFF8A" android:textSize="12sp"
                android:paddingBottom="4dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Flip horizontally" android:textColor="#FFFFFF" />
                <Switch android:id="@+id/p_flip" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Stats overlay" android:textColor="#FFFFFF" />
                <Switch android:id="@+id/p_overlay" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Lock rotation" android:textColor="#FFFFFF" />
                <Switch android:id="@+id/p_rotlock" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView android:id="@+id/p_bright_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Brightness"
                android:textColor="#FFFFFF" android:paddingTop="8dp" />
            <SeekBar android:id="@+id/p_bright" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="200" />

            <TextView android:id="@+id/p_contrast_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Contrast"
                android:textColor="#FFFFFF" />
            <SeekBar android:id="@+id/p_contrast" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="200" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Applies to the live stream" android:textColor="#FFD08A" android:textSize="12sp"
                android:paddingTop="16dp" android:paddingBottom="4dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Resolution  (reconnects)" android:textColor="#FFD08A" />
            <Spinner android:id="@+id/p_res" android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Frame rate" android:textColor="#FFFFFF" />
            <Spinner android:id="@+id/p_fps" android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Quality" android:textColor="#FFFFFF" />
            <Spinner android:id="@+id/p_quality" android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Audio" android:textColor="#FFFFFF" />
                <Switch android:id="@+id/p_audio" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView android:id="@+id/p_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text=""
                android:textColor="#FFD08A" android:textSize="12sp" android:paddingTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Floating action menu, LAST child so it draws above the surface AND the settings
         panel, and gets touch dispatch first (GlDisplayView consumes MotionEvents without
         calling super, so anything interactive must be a later sibling).

         Laid out as a column so the items cannot overlap. An earlier version placed two
         buttons separately and relied on layout_marginEnd to separate them; that margin
         lost to layout_margin on the same view and one button drew straight over the
         other, leaving a button that was present, tappable and invisible. -->
    <LinearLayout
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Actions: hidden until the fab is tapped. Each applies to the LIVE stream. -->
        <LinearLayout
            android:id="@+id/fab_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <Button
                android:id="@+id/act_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#B0000000"
                android:text="⚙  Settings" />

            <Button
                android:id="@+id/act_keyboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#B0000000"
                android:text="⌨  Keyboard" />

            <Button
                android:id="@+id/act_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#B0000000"
                android:text="Audio: on" />

            <Button
                android:id="@+id/act_touch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#B0000000"
                android:text="Touch: on" />

            <!-- Ends the session deliberately: the host is told (BYE) so it removes the
                 monitor instead of waiting for a client that is not coming back. Tinted
                 apart from the toggles above because it leaves the stream. -->
            <Button
                android:id="@+id/act_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#B0B4231F"
                android:text="Disconnect" />
        </LinearLayout>

        <Button
            android:id="@+id/fab_main"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="#C0202020"
            android:contentDescription="Menu"
            android:text="☰" />
    </LinearLayout>

</FrameLayout>
